rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in clients (anonymous auth) can touch data. The app's
    // passcode is a UX gate; this is the actual access boundary.
    function signedIn() {
      return request.auth != null;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();
    }

    // The maintenance history is append-only: entries can be read and created,
    // never edited or deleted. The {path=**} form also covers the collection
    // group query the Excel export runs across every room's log.
    match /{path=**}/log/{entryId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /deviceTokens/{token} {
      allow read: if false;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }
  }
}
