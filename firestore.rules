rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in clients (anonymous auth) can touch data. This is the
    // app's access boundary -- there is no gate in front of it.
    function signedIn() {
      return request.auth != null;
    }

    match /tickets/{ticketId} {
      // Closing a job, reopening it and correcting its notes are all updates.
      // Nothing in the app deletes a report: the list of jobs is the record
      // the spreadsheet is built from.
      allow read, create, update: if signedIn();
      allow delete: if false;

      // Photos are compressed JPEGs held inline, so each one is a document of
      // its own -- that keeps the ticket small enough for the list to stream
      // every report without pulling the images down with it. A bad shot can
      // be deleted; an existing one is never rewritten.
      match /photos/{photoId} {
        allow read, create, delete: if signedIn();
        allow update: if false;
      }
    }
  }
}
